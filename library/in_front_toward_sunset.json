{
  "name": "in_front_toward_sunset",
  "about": "a in the foreground of b with the sun setting behind b (within 20 deg): both in one frame, a clearly nearer (under 0.8 of b's distance), a in view, the top of b showing. Its must (one frame, a nearer, b at bearing 180-330 deg) drops points before any skyline is traced, so use it as a must. For briefs like 'a building in the foreground, the sun setting behind the tower (lab: foreground-sunset)'",
  "params": [
    "a",
    "b"
  ],
  "must": {
    "op": "and",
    "of": [
      {
        "op": "gt",
        "x": {
          "f": "in_frame",
          "a": "a",
          "b": "b"
        },
        "than": {
          "num": 0
        }
      },
      {
        "op": "lt",
        "x": {
          "f": "dist",
          "obj": "a"
        },
        "than": {
          "op": "mul",
          "of": [
            {
              "f": "dist",
              "obj": "b"
            },
            {
              "num": 0.8
            }
          ]
        }
      },
      {
        "op": "gt",
        "x": {
          "op": "bump",
          "x": {
            "f": "bearing",
            "obj": "b"
          },
          "at": 255,
          "width": 75
        },
        "than": {
          "num": 0
        }
      }
    ]
  },
  "score": {
    "op": "mul",
    "of": [
      {
        "f": "in_frame",
        "a": "a",
        "b": "b"
      },
      {
        "op": "lt",
        "x": {
          "f": "dist",
          "obj": "a"
        },
        "than": {
          "op": "mul",
          "of": [
            {
              "f": "dist",
              "obj": "b"
            },
            {
              "num": 0.8
            }
          ]
        }
      },
      {
        "f": "visible",
        "obj": "a"
      },
      {
        "op": "ramp",
        "x": {
          "f": "visible",
          "obj": "b"
        },
        "lo": 0,
        "hi": 0.4
      },
      {
        "op": "bump",
        "x": {
          "f": "sun_bearing_diff",
          "obj": "b"
        },
        "at": 0,
        "width": 20
      }
    ]
  }
}
