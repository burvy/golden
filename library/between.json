{
  "name": "between",
  "about": "a framed between left and right, all three in one frame",
  "params": ["a", "left", "right"],
  "must": { "op": "and", "of": [
    { "op": "gt", "x": { "f": "bearing_diff", "a": "a", "b": "left" }, "than": { "num": 0 } },
    { "op": "lt", "x": { "f": "bearing_diff", "a": "a", "b": "right" }, "than": { "num": 0 } },
    { "f": "in_frame", "a": "left", "b": "right" }
  ] },
  "score": { "op": "avg", "of": [
    { "op": "bump", "x": { "op": "add", "of": [
      { "f": "bearing_diff", "a": "a", "b": "left" },
      { "f": "bearing_diff", "a": "a", "b": "right" }
    ] }, "at": 0, "width": 20 },
    { "f": "in_frame", "a": "left", "b": "right" },
    { "f": "visible", "obj": "a" }
  ] }
}
